<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Threads Store</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <h1>THREADS</h1>
    </header>
    <main class="auth-container">
        <h2>Create Account</h2>
        <% if (error) { %>
            <div class="alert-error"><%= error %></div>
        <% } %>
        <form action="/signup" method="POST">
            <div class="input-group">
                <label>Email Address</label>
                <input type="email" name="email" required placeholder="name@domain.com">
            </div>
            <div class="input-group">
                <label>Password</label>
                <input type="password" name="password" required placeholder="Minimum 6 characters">
            </div>
            <button type="submit" class="btn block">Register Now</button>
        </form>
        <p class="auth-switch">Already registered? <a href="/login">Sign In instead</a></p>
    </main>
</body>
</html>
