<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - Threads</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="store-nav">
        <h1><a href="/" style="color: white; text-decoration: none;">THREADS</a></h1>
        <a href="/logout" class="logout-link">Logout</a>
    </header>
    <main class="detail-container">
        <img src="<%= product.img %>" alt="<%= product.name %>">
        <div class="details">
            <h2><%= product.name %></h2>
            <p class="price">₹<%= product.price %></p>
            <p class="desc">Premium cotton fabrication with clean aesthetic panelling. Perfect for effortless layering.</p>
            <button class="btn accent" onclick="alert('Added to cart!')">Add to Cart</button>
        </div>
    </main>
</body>
</html>
